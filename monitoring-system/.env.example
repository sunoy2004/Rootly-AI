# Database & messaging (Docker service hostnames)
POSTGRES_URL=postgresql+asyncpg://monitor:monitor123@postgres:5432/monitoring
REDIS_URL=redis://redis:6379

# Observability (Docker service hostnames)
ES_URL=http://elasticsearch:9200
PROMETHEUS_URL=http://prometheus:9090
JAEGER_URL=http://jaeger:16686

# Vector memory (Docker service hostname; internal port 8000)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# LLM — Groq (primary)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback OpenAI-compatible API (optional)
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# Auth (Incident Manager / Dashboard)
JWT_SECRET=change_this_to_random_string
JWT_ALGORITHM=HS256

# AI batch processing (seconds between Groq calls)
AI_BATCH_INTERVAL_SEC=20
ANOMALY_DETECTION_INTERVAL_SEC=30
